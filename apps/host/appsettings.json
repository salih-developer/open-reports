{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "api": { "ClusterId": "reporting-api", "Match": { "Path": "/api/{**catch-all}" } },
      "health": { "ClusterId": "reporting-api", "Match": { "Path": "/health" } },
      "openapi": { "ClusterId": "reporting-api", "Match": { "Path": "/openapi.json" } },
      "embed": { "ClusterId": "reporting-api", "Match": { "Path": "/embed/{**catch-all}" } },
      "mcp": { "ClusterId": "reporting-api", "Match": { "Path": "/mcp/{**catch-all}" } }
    },
    "Clusters": {
      "reporting-api": {
        "HttpRequest": { "ActivityTimeout": "00:10:00" },
        "Destinations": {
          "node": { "Address": "http://127.0.0.1:4000/" }
        }
      }
    }
  }
}
