<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.7204101">

  <!-- Shows the designer SPA in Visual Studio's solution. pnpm installs it and builds it during development;
       building the solution never runs npm. Publishing the host runs this package's "build" script (tsc + Vite)
       and copies dist into the host's wwwroot, so build the workspace packages first (pnpm build:all). -->
  <PropertyGroup>
    <ShouldRunNpmInstall>false</ShouldRunNpmInstall>
    <ShouldRunBuildScript>false</ShouldRunBuildScript>
    <BuildOutputFolder>$(MSBuildProjectDirectory)\dist</BuildOutputFolder>
  </PropertyGroup>

</Project>
